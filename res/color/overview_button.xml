<?xml version="1.0" encoding="utf-8"?>
<!-- CubeOS: the app switcher's backdrop is always near-black (Cube Recents), so its action
     labels and icons are always light; materialColorOnSurface went dark grey in light theme. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item
        android:alpha="0.92"
        android:color="@android:color/white"
        android:state_enabled="true" />
    <item
        android:alpha="0.38"
        android:color="@android:color/white"
        android:state_enabled="false" />
</selector>
